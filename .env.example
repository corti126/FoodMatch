# ---------------------------------------------------------------
# Plantilla de variables de entorno para La Carta de Hoy
# Copiá este archivo como `.env.local` y completá los valores.
# Nunca subas `.env.local` al repositorio.
# ---------------------------------------------------------------

# --- Spoonacular Food API ---
# https://spoonacular.com/food-api/docs
# Conseguí tu clave gratuita en https://spoonacular.com/food-api
# IMPORTANTE: Vite expone al navegador las variables que empiezan con VITE_.
# Esta clave será visible para quien inspeccione la aplicación publicada.
# Ver README.md ("Limitaciones de la API key") para más detalles.
VITE_SPOONACULAR_API_KEY=

# --- Firebase (configuración pública del cliente) ---
# Firebase Console > Configuración de tu proyecto > Tus apps > SDK
# Estos valores son públicos por diseño: la seguridad real la aportan
# Authentication y las reglas de Firestore.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
